---
// Shown for any address that doesn't exist on the site.
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Isuru K. Premasiri" description="This page doesn't exist.">
  <main id="main" class="nf">
    <p class="nf-code">404</p>
    <h1 class="nf-title">This page took a wrong turn.</h1>
    <p class="nf-text">The address may be old or mistyped. Everything I've built is one click away.</p>
    <a href="/" class="nf-link">Back to the portfolio</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 1rem;
    text-align: center;
    background: #000;
    color: #fff;
  }

  .nf-code {
    font-size: 0.75rem;
    letter-spacing: 0.4em;
    color: rgba(255, 255, 255, 0.4);
  }

  .nf-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 300;
  }

  .nf-text {
    max-width: 28rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .nf-link {
    margin-top: 1rem;
    padding: 0.8rem 1.6rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .nf-link:hover,
  .nf-link:focus-visible {
    background: #fff;
    color: #000;
  }
</style>
