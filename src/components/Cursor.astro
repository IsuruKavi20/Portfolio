<style>
  body {
    cursor: none;
  }
  button,
  a {
    cursor: pointer;
  }

  .cursor-dot,
  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 9999;
  }

  .cursor-dot {
    width: 5px;
    height: 5px;
    background: white;
    border-radius: 50%;
  }

  .cursor-ring {
    width: 25px;
    height: 25px;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 50%;
    z-index: 9997;
  }
  .cursor-hover {
  transform: translate(-50%, -50%) scale(1.5);
  border-color: white;
  }
 
</style>

<div class="cursor-dot" id="cursorDot"></div>
<div class="cursor-ring" id="cursorRing"></div>
