---
import { Image } from 'astro:assets';
import portrait from '../assets/images/portrait.png';
---
<section id="hero" class="relative bg-black text-white h-screen flex flex-col justify-center overflow-hidden opacity-0">

  <div class="max-w-7xl mx-auto w-full grid md:grid-cols-2 items-center px-12 flex-1">

    <!-- LEFT: TEXT -->
    <div>



      <h1 class="font-light leading-none mb-8" style="font-size: clamp(3rem, 6vw, 5.5rem);">
        <span class="word block">Isuru K.</span>
        <span class="word block">Premasiri</span>
      </h1>

      <div id="hero-line" class="w-16 h-px bg-white mb-8 origin-left scale-x-0" style="opacity:0.3"></div>

      <p id="hero-subtitle" class="text-xl text-gray-400 mb-4 opacity-0">
        Creative Developer
      </p>

      <p id="hero-desc" class="text-gray-500 max-w-md leading-relaxed opacity-0">
        Exploring the boundary between design and code —<br/>
        building interactive web experiences that feel cinematic.
      </p>

      <!-- Social links -->
      <div id="hero-socials" class="flex items-center gap-5 mt-8 opacity-0">

        <a href="https://github.com/isurukavi20" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>

        <span class="social-divider"></span>

        <a href="https://linkedin.com/in/isurukavi20" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>

        <span class="social-divider"></span>

        <!-- Download CV Button -->
        <a href="/cv.pdf" download="Isuru_K_Premasiri_CV.pdf" class="cv-btn">
          Download CV
        </a>

      </div>

    </div>

    <!-- RIGHT: PORTRAIT -->
    <div class="relative h-full flex items-center justify-end" style="max-height: calc(100vh - 4rem)">
      <Image
        id="hero-portrait"
        src={portrait}
        alt="Isuru K. Premasiri"
        widths={[480, 768]}
        sizes="(min-width: 768px) 40vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="portrait-img h-full w-auto object-cover opacity-0"
      />
    </div>

  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 text-xs tracking-widest text-gray-600 flex flex-col items-center">
    <span>SCROLL</span>
    <div class="scroll-line mt-3">
      <div class="scroll-drip"></div>
    </div>
  </div>

</section>




<style>

.portrait-img {
  filter: grayscale(100%);
  mask-image:
    linear-gradient(to right,  transparent 0%, black 20%, black 80%, transparent 100%),
    linear-gradient(to bottom, transparent 0%, black 5%,  black 85%, transparent 100%);
  mask-composite: intersect;
  -webkit-mask-image:
    linear-gradient(to right,  transparent 0%, black 20%, black 80%, transparent 100%),
    linear-gradient(to bottom, transparent 0%, black 5%,  black 85%, transparent 100%);
  -webkit-mask-composite: source-in;
}

.scroll-line {
  width: 1px;
  height: 60px;
  background: rgba(255,255,255,0.12);
  position: relative;
  overflow: hidden;
}

.scroll-drip {
  position: absolute;
  top: 60px;
  left: 0;
  width: 1px;
  height: 30px;
  background: linear-gradient(to top, transparent, rgba(255,255,255,0.8), transparent);
  animation: drip 1.6s ease-in-out infinite;
}

@keyframes drip {
  0%   { top: 60px; opacity: 0; }
  20%  { opacity: 1; }
  80%  { opacity: 1; }
  100% { top: -30px; opacity: 0; }
}

.word {
  display: block;
}

.social-link {
  color: rgba(255, 255, 255, 0.3);
  transition: color 0.3s ease, transform 0.3s ease;
  display: flex;
  align-items: center;
}

.social-link:hover {
  color: rgba(255, 255, 255, 0.85);
  transform: translateY(-2px);
}

.social-divider {
  display: inline-block;
  width: 1px;
  height: 16px;
  background: rgba(255, 255, 255, 0.12);
}

.cv-btn {
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.15);
  padding: 8px 16px;
  border-radius: 2px;
  font-family: 'Inter', sans-serif;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cv-btn:hover {
  background: white;
  color: black;
  border-color: white;
}

</style>