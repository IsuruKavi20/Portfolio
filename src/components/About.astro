---
import { Image } from 'astro:assets';
import aboutPhoto from '../assets/images/about.png';
---

<section id="about" class="relative bg-black text-white min-h-screen flex flex-col justify-center py-24 overflow-hidden">

  <!-- Photo behind the text -->
  <Image
    id="about-photo"
    src={aboutPhoto}
    alt="Isuru K. Premasiri seated in a studio"
    widths={[480, 768]}
    sizes="(min-width: 768px) 38vw, 90vw"
    class="about-photo"
  />

  <!-- Big letters ON TOP of the photo -->
  <div id="about-clip" class="relative w-full leading-none z-10">
    <h2 class="clip-text">ABOUT<br/>ME</h2>
  </div>

  <!-- Right-side info panel -->
  <div id="about-info" class="about-info max-w-sm z-20" data-reveal>

    <p class="text-xs tracking-[0.4em] text-gray-500 uppercase mb-4">WHO I AM</p>
    <div id="about-divider" class="w-8 h-px bg-white/30 mb-8 origin-left"></div>

    <h3 class="text-3xl font-light leading-snug mb-6 text-white">
      I start with how it <em class="not-italic text-gray-400">feels,</em><br/>
      then build what makes it <em class="not-italic text-gray-400">work.</em>
    </h3>

    <p class="text-gray-500 leading-relaxed mb-8 text-sm">
      I'm <span class="text-gray-300">Isuru K. Premasiri</span>, an IT student at the University of
      Moratuwa who learns by building. I love shaping clean, smooth screens, then digging into
      everything behind them: how the system fits together, how it talks over the network, and how
      it runs in the cloud. Lately I've started exploring cybersecurity, one small lesson at a time.
    </p>

    <div class="flex flex-wrap gap-2">
      <span class="tag">REACT</span>
      <span class="tag">UI DESIGN</span>
      <span class="tag">TYPESCRIPT</span>
      <span class="tag">SPRING BOOT</span>
      <span class="tag">SYSTEM ARCHITECTURE</span>
      <span class="tag">KUBERNETES</span>
      <span class="tag">AWS</span>
    </div>

  </div>

  <!-- Scroll-out darkening overlay -->
  <div id="about-overlay" class="about-overlay"></div>

</section>



<style>

/* Photo sits behind everything */
.about-photo {
  position: absolute;
  left: 3%;
  top: 50%;
  width: 38%;
  object-fit: cover;
  /* The photo file is already black and white, so no grayscale filter is needed */
  filter: brightness(0.75);
  z-index: 1;

  /* Fade edges so it blends into black */
  mask-image:
    linear-gradient(to right,  transparent 0%, black 12%, black 80%, transparent 100%),
    linear-gradient(to bottom, transparent 0%, black 8%,  black 88%, transparent 100%);
  mask-composite: intersect;
  -webkit-mask-image:
    linear-gradient(to right,  transparent 0%, black 12%, black 80%, transparent 100%),
    linear-gradient(to bottom, transparent 0%, black 8%,  black 88%, transparent 100%);
  -webkit-mask-composite: source-in;
}

/* Big outlined text sits on top of photo using mix-blend-mode */
.clip-text {
  font-size: 13vw;
  font-weight: 800;
  line-height: 0.78;
  letter-spacing: -0.02em;
  padding-left: 8vw;
  display: block;
  width: 100%;

  /* Outlined white letters — photo behind is visible through them */
  color: transparent;
  -webkit-text-stroke: 3px rgba(255, 255, 255, 0.7);

  /* mix-blend-mode: difference inverts where text meets the photo = beautiful contrast */
  mix-blend-mode: difference;
}

.tag {
  display: inline-block;
  padding: 5px 14px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  font-size: 10px;
  letter-spacing: 0.2em;
  color: rgba(255, 255, 255, 0.5);
  border-radius: 2px;
  transition: border-color 0.3s ease, color 0.3s ease;
}

.tag:hover {
  border-color: rgba(255, 255, 255, 0.5);
  color: rgba(255, 255, 255, 0.9);
}
/* Desktop: the info panel floats on the right, vertically centred */
.about-info {
  position: absolute;
  right: 4rem;
  top: 50%;
  transform: translateY(calc(-50% + 30px));
}

/* ── Phones: photo on top, the big letters cut across its lower edge,
      then the text flows below. Nothing overlaps the reading text. ── */
@media (max-width: 767px) {
  #about {
    justify-content: flex-start;
    padding-top: 6rem;
    padding-bottom: 5rem;
    min-height: 0;
  }

  .about-photo {
    position: relative;
    left: auto;
    top: auto;
    width: 82%;
    margin-left: auto;   /* photo leans right, letters start left: an off-centre, editorial look */
  }

  #about-clip {
    /* Pull the letters up so they overlap the bottom of the photo */
    margin-top: -0.9em;
    font-size: 22vw;
  }

  .clip-text {
    font-size: 1em;
    padding-left: var(--gutter);
    -webkit-text-stroke-width: 2px;
  }

  .about-info {
    position: relative;
    right: auto;
    top: auto;
    max-width: none;
    margin-top: 2.5rem;
    padding-inline: var(--gutter);
    transform: translateY(30px);
  }

  .about-info h3 {
    font-size: 1.6rem;
  }
}

.about-overlay{
  position:absolute;
  inset:0;
  background:black;
  opacity:0;
  pointer-events:none;
  z-index:30;
}

</style>