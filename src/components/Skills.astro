---
---

<section id="skills" class="bg-black text-white py-40 overflow-hidden">

  <!-- Header -->
  <div class="max-w-7xl mx-auto px-16 mb-24">
    <p id="skills-label" class="text-xs tracking-[0.4em] text-gray-500 uppercase mb-5 opacity-0">CAPABILITIES</p>
    <h2 id="skills-title" class="text-5xl font-light text-white opacity-0">
      Skills &amp; Technologies
    </h2>
  </div>

  <!-- Skills Grid — 4 cols separated by hairline -->
  <div class="max-w-7xl mx-auto grid md:grid-cols-2 lg:grid-cols-4 gap-4">

    <!-- Frontend -->
    <div class="skill-card" id="skill-col-0">
      <p class="skill-category">FRONTEND</p>
      <ul class="skill-list">
        <li>HTML5</li>
        <li>CSS3</li>
        <li>JavaScript</li>
        <li>TypeScript</li>
        <li>React</li>
        <li>Tailwind CSS</li>
        <li>Astro</li>
      </ul>
    </div>

    <!-- Backend -->
    <div class="skill-card" id="skill-col-1">
      <p class="skill-category">BACKEND</p>
      <ul class="skill-list">
        <li>Node.js</li>
        <li>Python</li>
        <li>Java</li>
        <li>.NET</li>
        <li>REST API</li>
      </ul>
    </div>

    <!-- Database -->
    <div class="skill-card" id="skill-col-2">
      <p class="skill-category">DATABASE</p>
      <ul class="skill-list">
        <li>MySQL</li>
        <li>MongoDB</li>
        <li>SQL Server</li>
      </ul>
    </div>

    <!-- Tools -->
    <div class="skill-card" id="skill-col-3">
      <p class="skill-category">TOOLS</p>
      <ul class="skill-list">
        <li>Git &amp; GitHub</li>
        <li>Docker</li>
        <li>VS Code</li>
        <li>Figma</li>
        <li>Linux</li>
      </ul>
    </div>

  </div>

</section>




<style>

#skills-label,
#skills-title {
  transform: translateY(16px);
}

.skill-card {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 28px 24px;
  transition: border-color 0.4s ease;
}

.skill-card:hover {
  border-color: rgba(255, 255, 255, 0.35);
}

.skill-category {
  font-size: 9px;
  letter-spacing: 0.35em;
  color: rgba(255, 255, 255, 0.25);
  margin-bottom: 28px;
  font-family: 'Inter', sans-serif;
}

.skill-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.skill-list li {
  font-size: 14px;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.55);
  padding: 12px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  font-family: 'Inter', sans-serif;
  transition: color 0.25s ease;
  cursor: default;
}

.skill-list li:last-child {
  border-bottom: none;
}

.skill-list li:hover {
  color: rgba(255, 255, 255, 0.9);
}

</style>