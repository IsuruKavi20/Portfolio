---
---

<section id="skills" class="relative bg-black text-white py-40 overflow-hidden">

  <!-- Header — line + label + compact title (same structure as projects, smaller font) -->
  <div class="max-w-7xl mx-auto px-6 md:px-16 mb-24">

    <div class="flex items-center gap-6 mb-6">
      <div id="skills-line" class="skills-line"></div>
      <p id="skills-label" class="text-xs uppercase tracking-[0.4em] text-gray-500 opacity-0">CAPABILITIES</p>
    </div>

    <h2 id="skills-title" class="skills-title opacity-0">
      Skills &amp; Technologies
    </h2>

    <p id="skills-desc" class="skills-desc opacity-0">
      A growing toolkit of languages, frameworks, and tools<br/>
      built through projects, study, and hands-on experience.
    </p>

  </div>

  <!-- Skills Grid — 4 cols with hairline separator -->
  <div class="max-w-7xl mx-auto px-6 md:px-16 grid md:grid-cols-2 lg:grid-cols-4 divide-x divide-white/[0.06]">

    <!-- Frontend -->
    <div class="skill-card" id="skill-col-0">
      <div class="skill-bar"></div>
      <p class="skill-category">FRONTEND</p>
      <ul class="skill-list">
        <li>HTML5</li>
        <li>CSS3</li>
        <li>JavaScript</li>
        <li>TypeScript</li>
        <li>React</li>
        <li>Tailwind CSS</li>
        <li>Astro</li>
      </ul>
    </div>

    <!-- Backend -->
    <div class="skill-card" id="skill-col-1">
      <div class="skill-bar"></div>
      <p class="skill-category">BACKEND</p>
      <ul class="skill-list">
        <li>Node.js</li>
        <li>Python</li>
        <li>Java</li>
        <li>.NET</li>
        <li>REST API</li>
      </ul>
    </div>

    <!-- Database -->
    <div class="skill-card" id="skill-col-2">
      <div class="skill-bar"></div>
      <p class="skill-category">DATABASE</p>
      <ul class="skill-list">
        <li>MySQL</li>
        <li>MongoDB</li>
        <li>SQL Server</li>
      </ul>
    </div>

    <!-- Tools -->
    <div class="skill-card" id="skill-col-3">
      <div class="skill-bar"></div>
      <p class="skill-category">TOOLS</p>
      <ul class="skill-list">
        <li>Git &amp; GitHub</li>
        <li>Docker</li>
        <li>VS Code</li>
        <li>Figma</li>
        <li>Linux</li>
      </ul>
    </div>

  </div>

  <!-- Scroll-out darkening overlay -->
  <div id="skills-overlay" class="skills-overlay"></div>

</section>

<style>

/* ── Header ── */
.skills-line {
  width: 48px;
  height: 1px;
  background: rgba(255, 255, 255, 0.25);
  transform-origin: left;
}

:global(.motion) .skills-line {
  transform: scaleX(0);
}

/* Same font size as original — compact, not giant */
.skills-title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 300;
  letter-spacing: -0.01em;
  line-height: 1.1;
  color: white;
  font-family: 'Inter', sans-serif;
  transform: translateY(16px);
}

.skills-desc {
  margin-top: 16px;
  font-size: 13px;
  line-height: 1.9;
  color: rgba(255, 255, 255, 0.35);
  max-width: 480px;
  font-family: 'Inter', sans-serif;
  transform: translateY(16px);
}

#skills-label {
  transform: translateY(16px);
}

/* ── Cards ── */
.skill-card {
  position: relative;
  background: transparent;
  padding: 32px 28px;
  overflow: hidden;
  transition: background 0.4s ease, transform 0.4s ease;
}

.skill-card:hover {
  background: rgba(255, 255, 255, 0.02);
  transform: translateY(-4px) !important;
}

/* Glowing top accent bar — same as project card */
.skill-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s ease;
}

.skill-card:hover .skill-bar {
  transform: scaleX(1);
}

.skill-category {
  font-size: 9px;
  letter-spacing: 0.35em;
  color: rgba(255, 255, 255, 0.25);
  margin-bottom: 28px;
  font-family: 'Inter', sans-serif;
  text-transform: uppercase;
}

.skill-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.skill-list li {
  font-size: 14px;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.55);
  padding: 12px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  font-family: 'Inter', sans-serif;
  transition: color 0.25s ease;
  cursor: default;
  /* Ensure no background/border-box interference */
  background: transparent;
}

.skill-list li:last-child {
  border-bottom: none;
}

.skill-list li:hover {
  color: rgba(255, 255, 255, 0.85);
}

/* ── Scroll-out overlay ── */
.skills-overlay {
  position: absolute;
  inset: 0;
  background: black;
  opacity: 0;
  pointer-events: none;
  z-index: 30;
}

</style>