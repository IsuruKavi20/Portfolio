---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section id="projects" class="relative bg-black text-white py-40 overflow-hidden">

  <div class="max-w-7xl mx-auto px-6 md:px-16">

    <!-- Section header -->
    <div class="projects-header mb-20">

      <div class="flex items-center gap-6 mb-6">
        <div id="proj-line" class="proj-line"></div>
        <p id="proj-label" class="text-xs uppercase tracking-[0.4em] text-gray-500 opacity-0">
          Selected Work
        </p>
      </div>

      <h2 id="proj-title" class="proj-title opacity-0">
        Projects
      </h2>

      <p id="proj-desc" class="proj-desc opacity-0">
        A curated collection of builds, experiments, and upcoming work.<br/>
        Each project represents a step forward in craft and curiosity.
      </p>

    </div>

    <!-- Cards grid -->
    <div class="proj-grid">
      {projects.map((project, i) => (
        <div class="proj-card-wrap" data-index={i}>
          <ProjectCard {...project} />
        </div>
      ))}
    </div>

  </div>

  <!-- Scroll-out darkening overlay -->
  <div id="projects-overlay" class="projects-overlay"></div>

</section>

<style>

.proj-line {
  width: 0px;
  height: 1px;
  background: rgba(255, 255, 255, 0.25);
  transition: width 0.8s ease;
}

.proj-title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 300;
  letter-spacing: -0.01em;
  line-height: 1.1;
  color: white;
  font-family: 'Inter', sans-serif;
  transform: translateY(20px);
}

.proj-desc {
  margin-top: 20px;
  font-size: 13px;
  line-height: 1.9;
  color: rgba(255, 255, 255, 0.35);
  max-width: 480px;
  font-family: 'Inter', sans-serif;
  transform: translateY(20px);
}

#proj-label {
  transform: translateY(20px);
}

.proj-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.proj-card-wrap {
  background: black;
}

.projects-overlay {
  position: absolute;
  inset: 0;
  background: black;
  opacity: 0;
  pointer-events: none;
  z-index: 30;
}

</style>