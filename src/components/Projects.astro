---
import SectionHeader from './SectionHeader.astro';
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="relative bg-black text-white py-24 md:py-40 overflow-hidden">

  <div class="max-w-7xl mx-auto px-6 md:px-16">

    <!-- Section header -->
    <div class="projects-header mb-14 md:mb-20">

      <SectionHeader
        prefix="proj"
        label="Selected Work"
        title="Projects"
        description="A curated collection of builds, experiments, and upcoming work. Each project represents a step forward in craft and curiosity."
      />

    </div>

    <!-- Cards grid; a swipe carousel on phones -->
    <div id="projects-row" data-snap-row class="proj-grid snap-row">
      {projects.map((project, i) => (
        <div class="proj-card-wrap" data-index={i}>
          <ProjectCard
            id={project.id}
            number={String(i + 1).padStart(2, "0")}
            title={project.data.title}
            summary={project.data.summary}
            status={project.data.status}
            tech={project.data.tech}
            links={project.data.links}
          />
        </div>
      ))}
    </div>

    <!-- Phones only: which card you are on -->
    <p class="snap-count" data-snap-count="projects-row" aria-hidden="true">
      <span data-snap-current>01</span>
      <span class="snap-count-track"><span class="snap-count-fill"></span></span>
      <span data-snap-total>{String(projects.length).padStart(2, '0')}</span>
    </p>

  </div>

  <!-- Scroll-out darkening overlay -->
  <div id="projects-overlay" class="projects-overlay"></div>

</section>

<style>






.proj-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.proj-card-wrap {
  background: black;
}

/* ── Phones: the grid becomes a swipe carousel (see .snap-row in global.css) ── */
@media (max-width: 767px) {
  .proj-grid {
    display: flex;
    gap: 12px;
    background: none;
    border: none;
    /* Reach the screen edges so cards can slide in and out of view;
       1.5rem cancels the container's side padding (px-6) */
    margin-inline: -1.5rem;
  }

  .proj-card-wrap {
    background: none;
  }

  /* The row already lines up with the page text, so no extra padding */
  #projects .snap-count {
    padding-inline: 0;
  }

  /* The card in view lights up, like hover does on desktop */
  .proj-card-wrap.is-active :global(.project-card) {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .proj-card-wrap.is-active :global(.card-bar) {
    transform: scaleX(1);
  }

  .proj-card-wrap :global(.project-card:hover) {
    transform: none;
  }
}

.projects-overlay {
  position: absolute;
  inset: 0;
  background: black;
  opacity: 0;
  pointer-events: none;
  z-index: 30;
}

</style>