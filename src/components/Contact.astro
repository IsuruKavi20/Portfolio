---
---

<section id="contact" class="relative bg-black text-white py-40 overflow-hidden">

  <div class="max-w-7xl mx-auto px-6 md:px-16">

    <!-- Header — same pattern as all other sections -->
    <div class="mb-20">

      <div class="flex items-center gap-6 mb-6">
        <div id="contact-line" class="contact-line"></div>
        <p id="contact-label" class="text-xs uppercase tracking-[0.4em] text-gray-500 opacity-0">
          Say Hello
        </p>
      </div>

      <h2 id="contact-title" class="contact-title opacity-0">
        Get In Touch
      </h2>

      <p id="contact-desc" class="contact-desc opacity-0">
        I'm currently looking for internship opportunities. Whether you have a question<br/>
        or just want to say hi, feel free to reach out!
      </p>

    </div>

    <!-- Two-column layout: Form + Info -->
    <div id="contact-body" class="contact-layout opacity-0">

      <!-- Left: Contact form -->
      <form id="contact-form" class="contact-form" novalidate>

        <div class="form-row">
          <div class="form-group">
            <label for="cf-name" class="form-label">Your Name</label>
            <input id="cf-name" name="from_name" type="text" class="form-input" placeholder="Isuru Premasiri" required />
          </div>
          <div class="form-group">
            <label for="cf-email" class="form-label">Your Email</label>
            <input id="cf-email" name="from_email" type="email" class="form-input" placeholder="you@example.com" required />
          </div>
        </div>

        <div class="form-group">
          <label for="cf-subject" class="form-label">Subject</label>
          <input id="cf-subject" name="subject" type="text" class="form-input" placeholder="Internship opportunity / Collaboration" required />
        </div>

        <div class="form-group">
          <label for="cf-message" class="form-label">Message</label>
          <textarea id="cf-message" name="message" rows="6" class="form-input form-textarea" placeholder="Your message here…" required></textarea>
        </div>

        <button type="submit" id="contact-submit" class="submit-btn">
          <span id="submit-text">Send Message</span>
          <svg id="submit-icon" width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Status message -->
        <p id="form-status" class="form-status"></p>

      </form>

      <!-- Right: Social / direct links -->
      <div class="contact-info">

        <div class="info-block">
          <p class="info-label">Email</p>
          <a href="mailto:isurukpremasiri2001@gmail.com" class="info-link">isurukpremasiri2001@gmail.com</a>
        </div>

        <div class="info-block">
          <p class="info-label">LinkedIn</p>
          <a href="https://linkedin.com/in/isurukavi20" target="_blank" rel="noopener noreferrer" class="info-link">
            linkedin.com/in/isurukavi20
          </a>
        </div>

        <div class="info-block">
          <p class="info-label">GitHub</p>
          <a href="https://github.com/isurukavi20" target="_blank" rel="noopener noreferrer" class="info-link">
            github.com/isurukavi20
          </a>
        </div>

        <div class="info-block">
          <p class="info-label">Availability</p>
          <p class="info-value">
            <span class="avail-dot"></span>
            Open for internships &amp; collaborations
          </p>
        </div>

      </div>

    </div>

  </div>

  <!-- Scroll-out darkening overlay -->
  <div id="contact-overlay" class="contact-overlay"></div>

</section>

<!-- EmailJS SDK -->
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script>
// ── EmailJS Setup ──────────────────────────────
// 1. Sign up free at https://emailjs.com
// 2. Create an Email Service (Gmail, Outlook, etc.)
// 3. Create an Email Template with variables:
//    {{from_name}}, {{from_email}}, {{subject}}, {{message}}
// 4. Replace the three placeholders below with your IDs:

const EMAILJS_PUBLIC_KEY  = "YOUR_PUBLIC_KEY";   // Account → API Keys
const EMAILJS_SERVICE_ID  = "YOUR_SERVICE_ID";   // Email Services → Service ID
const EMAILJS_TEMPLATE_ID = "YOUR_TEMPLATE_ID";  // Email Templates → Template ID

emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });

const form       = document.getElementById("contact-form");
const submitBtn  = document.getElementById("contact-submit");
const submitText = document.getElementById("submit-text");
const submitIcon = document.getElementById("submit-icon");
const status     = document.getElementById("form-status");

form.addEventListener("submit", async (e) => {
  e.preventDefault();

  // Loading state
  submitBtn.disabled = true;
  submitText.textContent = "Sending…";
  submitIcon.style.display = "none";
  status.textContent = "";
  status.className = "form-status";

  try {
    await emailjs.sendForm(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, form);

    submitText.textContent = "Sent!";
    status.textContent = "✓ Message delivered. I'll get back to you soon.";
    status.classList.add("status-success");
    form.reset();

    setTimeout(() => {
      submitText.textContent = "Send Message";
      submitIcon.style.display = "";
      submitBtn.disabled = false;
      status.textContent = "";
      status.className = "form-status";
    }, 4000);

  } catch (err) {
    submitText.textContent = "Send Message";
    submitIcon.style.display = "";
    submitBtn.disabled = false;
    status.textContent = "✗ Something went wrong. Please email me directly.";
    status.classList.add("status-error");
  }
});
</script>

<style>

/* ── Header ── */
.contact-line {
  width: 0px;
  height: 1px;
  background: rgba(255, 255, 255, 0.25);
}

.contact-title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 300;
  letter-spacing: -0.01em;
  line-height: 1.1;
  color: white;
  font-family: 'Inter', sans-serif;
  transform: translateY(16px);
}

.contact-desc {
  margin-top: 16px;
  font-size: 13px;
  line-height: 1.9;
  color: rgba(255, 255, 255, 0.35);
  max-width: 540px;
  font-family: 'Inter', sans-serif;
  transform: translateY(16px);
}

#contact-label {
  transform: translateY(16px);
}

/* ── Layout ── */
.contact-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 60px;
  transform: translateY(30px);
}

@media (min-width: 900px) {
  .contact-layout {
    grid-template-columns: 1fr 340px;
    gap: 80px;
  }
}

/* ── Form ── */
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

@media (max-width: 640px) {
  .form-row { grid-template-columns: 1fr; }
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-label {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.3);
  font-family: 'Inter', sans-serif;
}

.form-input {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: white;
  font-size: 13px;
  font-family: 'Inter', sans-serif;
  font-weight: 300;
  padding: 14px 16px;
  outline: none;
  transition: border-color 0.3s ease, background 0.3s ease;
  border-radius: 0;
  width: 100%;
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.18);
}

.form-input:focus {
  border-color: rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.05);
}

.form-textarea {
  resize: vertical;
  min-height: 140px;
}

/* ── Submit button ── */
.submit-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  align-self: flex-start;
  padding: 14px 32px;
  background: white;
  color: black;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-family: 'Inter', sans-serif;
  font-weight: 500;
  border: none;
  cursor: pointer;
  transition: background 0.3s ease, color 0.3s ease, opacity 0.3s ease;
}

.submit-btn:hover {
  background: rgba(255, 255, 255, 0.88);
}

.submit-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ── Status ── */
.form-status {
  font-size: 12px;
  font-family: 'Inter', sans-serif;
  letter-spacing: 0.05em;
  min-height: 20px;
}

.status-success { color: rgba(120, 220, 150, 0.85); }
.status-error   { color: rgba(255, 120, 100, 0.85); }

/* ── Info panel ── */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding-top: 4px;
}

.info-block {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  padding-top: 20px;
}

.info-label {
  font-size: 9px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.25);
  font-family: 'Inter', sans-serif;
  margin-bottom: 10px;
}

.info-link {
  font-size: 13px;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.6);
  font-family: 'Inter', sans-serif;
  transition: color 0.3s ease;
}

.info-link:hover {
  color: white;
}

.info-value {
  font-size: 13px;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.6);
  font-family: 'Inter', sans-serif;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Pulsing green availability dot */
.avail-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(120, 220, 150, 0.85);
  animation: pulse-dot 2s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.5; transform: scale(0.8); }
}

/* ── Scroll-out overlay ── */
.contact-overlay {
  position: absolute;
  inset: 0;
  background: black;
  opacity: 0;
  pointer-events: none;
  z-index: 30;
}

</style>