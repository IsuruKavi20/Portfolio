---
import SectionHeader from './SectionHeader.astro';
---

<section id="contact" data-pause-offscreen class="relative bg-black text-white py-40 overflow-hidden">

  <div class="max-w-7xl mx-auto px-6 md:px-16">

    <!-- Header — same pattern as all other sections -->
    <div class="mb-20">

      <SectionHeader
        prefix="contact"
        label="Say Hello"
        title="Get In Touch"
        description="I'm currently looking for internship opportunities. Whether you have a question or just want to say hi, feel free to reach out!"
      />

    </div>

    <!-- Two-column layout: Form + Info -->
    <div id="contact-body" class="contact-layout" data-reveal>

      <!-- Left: Contact form -->
      <form id="contact-form" class="contact-form">

        <div class="form-row">
          <div class="form-group">
            <label for="cf-name" class="form-label">Your Name</label>
            <input id="cf-name" name="name" type="text" class="form-input" placeholder="Your name" maxlength="80" autocomplete="name" required />
          </div>
          <div class="form-group">
            <label for="cf-email" class="form-label">Your Email</label>
            <input id="cf-email" name="email" type="email" class="form-input" placeholder="you@example.com" maxlength="120" autocomplete="email" required />
          </div>
        </div>

        <div class="form-group">
          <label for="cf-subject" class="form-label">Subject</label>
          <input id="cf-subject" name="subject" type="text" class="form-input" placeholder="Internship opportunity / Collaboration" maxlength="120" />
        </div>

        <div class="form-group">
          <label for="cf-message" class="form-label">Message</label>
          <textarea id="cf-message" name="message" rows="6" class="form-input form-textarea" placeholder="Your message here…" minlength="10" maxlength="2000" required></textarea>
        </div>

        <!-- Trap for spam bots: hidden from people, so it stays empty. Bots fill it in. -->
        <div class="form-trap" aria-hidden="true">
          <label for="cf-website">Website</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" id="contact-submit" class="submit-btn">
          <span id="submit-text">Send Message</span>
          <svg id="submit-icon" width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Status message -->
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>

      </form>

      <!-- Right: Social / direct links -->
      <div class="contact-info">

        <div class="info-block">
          <p class="info-label">Email</p>
          <a href="mailto:isurukpremasiri2001@gmail.com" class="info-link">isurukpremasiri2001@gmail.com</a>
        </div>

        <div class="info-block">
          <p class="info-label">LinkedIn</p>
          <a href="https://www.linkedin.com/in/isuru-premasiri-992004432" target="_blank" rel="noopener noreferrer" class="info-link">
            linkedin.com/in/isuru-premasiri-992004432
          </a>
        </div>

        <div class="info-block">
          <p class="info-label">GitHub</p>
          <a href="https://github.com/isurukavi20" target="_blank" rel="noopener noreferrer" class="info-link">
            github.com/isurukavi20
          </a>
        </div>

        <div class="info-block">
          <p class="info-label">Availability</p>
          <p class="info-value">
            <span class="avail-dot"></span>
            Open for internships &amp; collaborations
          </p>
        </div>

      </div>

    </div>

  </div>

  <!-- Scroll-out darkening overlay -->
  <div id="contact-overlay" class="contact-overlay"></div>

</section>

<script>
// ── Contact form ───────────────────────────────
// Sends the message to /api/contact, which emails it to Isuru.
// The browser only checks for friendliness; the server checks everything again.
const form = document.getElementById('contact-form') as HTMLFormElement | null;
const status = document.getElementById('form-status');
const submitButton = document.getElementById('contact-submit') as HTMLButtonElement | null;
const submitText = document.getElementById('submit-text');
const openedAt = Date.now();   // how long the form was open (bots are instant)

function showStatus(message: string, kind: 'success' | 'error') {
  if (!status) return;
  status.textContent = message;
  status.className = `form-status status-${kind}`;
}

function setSending(isSending: boolean) {
  if (submitButton) submitButton.disabled = isSending;
  if (submitText) submitText.textContent = isSending ? 'Sending…' : 'Send Message';
}

form?.addEventListener('submit', async (event) => {
  event.preventDefault();
  if (!form || !form.reportValidity()) return;

  const data = new FormData(form);
  const field = (name: string) => String(data.get(name) ?? '').trim();

  setSending(true);
  showStatus('', 'success');
  try {
    const response = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: field('name'),
        email: field('email'),
        subject: field('subject'),
        message: field('message'),
        website: field('website'),
        elapsedMs: Date.now() - openedAt,
      }),
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(typeof result.error === 'string' ? result.error : '');
    showStatus(result.message ?? 'Thanks! Your message is on its way.', 'success');
    form.reset();
  } catch (error) {
    const message = error instanceof Error && error.message
      ? error.message
      : "Sorry, the message didn't go through. Please email me directly.";
    showStatus(message, 'error');
  } finally {
    setSending(false);
  }
});
</script>

<style>

/* ── Header ── */





/* ── Layout ── */
.contact-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 60px;
  transform: translateY(30px);
}

@media (min-width: 900px) {
  .contact-layout {
    grid-template-columns: 1fr 340px;
    gap: 80px;
  }
}

/* ── Form ── */
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

@media (max-width: 640px) {
  .form-row { grid-template-columns: 1fr; }
}

/* Spam trap: moved off screen (not display:none, which some bots skip) */
.form-trap {
  position: absolute;
  left: -10000px;
  width: 1px;
  height: 1px;
  overflow: hidden;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-label {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.55);
  font-family: 'Inter', sans-serif;
}

.form-input {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: white;
  font-size: 13px;
  font-family: 'Inter', sans-serif;
  font-weight: 300;
  padding: 14px 16px;
  outline: none;
  transition: border-color 0.3s ease, background 0.3s ease;
  border-radius: 0;
  width: 100%;
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.form-input:focus {
  border-color: rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.05);
}

.form-textarea {
  resize: vertical;
  min-height: 140px;
}

/* ── Submit button ── */
.submit-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  align-self: flex-start;
  padding: 14px 32px;
  background: white;
  color: black;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-family: 'Inter', sans-serif;
  font-weight: 500;
  border: none;
  cursor: pointer;
  transition: background 0.3s ease, color 0.3s ease, opacity 0.3s ease;
}

.submit-btn:hover {
  background: rgba(255, 255, 255, 0.88);
}

.submit-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ── Status ── */
.form-status {
  font-size: 12px;
  font-family: 'Inter', sans-serif;
  letter-spacing: 0.05em;
  min-height: 20px;
}

/* Monochrome like the rest of the site: a short line marks the message,
   success is bright white, an error is a softer grey with a cross */
.status-success,
.status-error {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  letter-spacing: 0.08em;
}

.status-success { color: rgba(255, 255, 255, 0.9); }
.status-error   { color: rgba(255, 255, 255, 0.6); }

.status-success::before {
  content: "";
  width: 24px;
  height: 1px;
  background: #fff;
}

.status-error::before {
  content: "×";
  font-size: 1rem;
  line-height: 1;
}

.form-status:empty::before {
  content: none;
}

/* ── Info panel ── */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding-top: 4px;
}

.info-block {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  padding-top: 20px;
}

.info-label {
  font-size: 9px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.45);
  font-family: 'Inter', sans-serif;
  margin-bottom: 10px;
}

.info-link {
  font-size: 13px;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.6);
  font-family: 'Inter', sans-serif;
  transition: color 0.3s ease;
}

.info-link:hover {
  color: white;
}

.info-value {
  font-size: 13px;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.6);
  font-family: 'Inter', sans-serif;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Pulsing green availability dot */
.avail-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(120, 220, 150, 0.85);
  animation: pulse-dot 2s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.5; transform: scale(0.8); }
}

/* ── Phones ── */
@media (max-width: 767px) {
  #contact {
    padding-block: 6rem;
  }

  .contact-layout {
    gap: 3.5rem;
  }

  /* Under 16px, iPhones zoom the whole page in when a field is tapped */
  .form-input {
    font-size: 16px;
    padding: 14px;
  }

  .submit-btn {
    align-self: stretch;
    justify-content: center;
    min-height: 52px;
  }

  .info-link {
    display: inline-block;
    padding-block: 6px;   /* easier to tap */
    word-break: break-word;
  }
}

/* ── Scroll-out overlay ── */
.contact-overlay {
  position: absolute;
  inset: 0;
  background: black;
  opacity: 0;
  pointer-events: none;
  z-index: 30;
}

</style>