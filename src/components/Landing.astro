<style>
.enterBtn {
  position: relative;
  font-size: 12px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: white;
  background: none;
  border: none;
  cursor: pointer;
  padding-bottom: 6px;
}

.enter-line {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 1px;
  width: 0%;
  background: white;
  transition: width 0.4s ease;
}

.enterBtn:hover .enter-line {
  width: 100%;
}
</style>
<section id="landing" class="fixed inset-0 bg-black text-white flex items-center justify-center z-50">

  <canvas id="landingCanvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

  <div class="relative text-center opacity-0 translate-y-6" id="landingContent">

    <h1 class="text-6xl font-light mb-10">
        Isuru K. Premasiri
    </h1>
    <p class="text-xs tracking-[0.4em] text-gray-500 uppercase mb-8">
        Portfolio — 2026
    </p>

    <button
        id="enterBtn"
        class="enterBtn"
    >
        Click to Enter
        <span class="enter-line"></span>
    </button>
  </div>

</section>

<script>

const canvas = document.getElementById("landingCanvas");
const ctx = canvas.getContext("2d");

let w, h;

function resize(){
  w = canvas.width = window.innerWidth;
  h = canvas.height = window.innerHeight;
}

resize();
window.addEventListener("resize", resize);

const lines = [];

class Line {
  constructor(){
    this.reset();
  }

  reset(){
    this.x = Math.random()*w;
    this.y = Math.random()*h;
    this.len = 80 + Math.random()*120;
    this.angle = Math.random()*Math.PI*2;
    this.speed = 0.003 + Math.random()*0.006;
    this.life = 0;
    this.maxLife = 200 + Math.random()*200;
  }

  draw(){
    this.life++;
    this.angle += this.speed;

    const ex = this.x + Math.cos(this.angle)*this.len;
    const ey = this.y + Math.sin(this.angle)*this.len;

    ctx.beginPath();
    ctx.strokeStyle = "rgba(255,255,255,0.09)";
    ctx.lineWidth = 1;

    ctx.moveTo(this.x,this.y);
    ctx.quadraticCurveTo(
      (this.x+ex)/2 + Math.cos(this.angle)*10,
      (this.y+ey)/2 + Math.sin(this.angle)*10,
      ex,
      ey
    );

    ctx.stroke();

    if(this.life > this.maxLife){
      this.reset();
    }
  }
}

for(let i=0;i<40;i++){
  lines.push(new Line());
}

function animate(){
  ctx.clearRect(0,0,w,h);
  lines.forEach(l=>l.draw());
  requestAnimationFrame(animate);
}

animate();
const landing = document.getElementById("landing");
const enterBtn = document.getElementById("enterBtn");

enterBtn.addEventListener("click", () => {

  landing.style.transition = "opacity 0.8s ease , transform 0.8s ease";
  landing.style.opacity = "0";
  landing.style.transform = "scale(1.03)";

  setTimeout(() => {
    landing.style.display = "none";
    window.dispatchEvent(new Event("landing:done"));
  }, 800);

});
const landingContent = document.getElementById("landingContent");

window.addEventListener("load", () => {

  setTimeout(() => {
    landingContent.style.transition = "all 1.2s ease";
    landingContent.style.opacity = "1";
    landingContent.style.transform = "translateY(0)";
  }, 300);

});

</script>