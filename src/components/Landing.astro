---
import cursor from '../components/Cursor.astro';
---
<style>
.enterBtn {
  position: relative;
  font-size: 12px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: white;
  background: none;
  border: none;
  cursor: pointer;
  padding-bottom: 6px;
}

.enter-line {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 1px;
  width: 0%;
  background: white;
  transition: width 0.4s ease;
}

.enterBtn:hover .enter-line {
  width: 100%;
}
</style>
<section id="landing" class="fixed inset-0 bg-black text-white flex items-center justify-center z-50">

  <!-- Spline 3D Background Iframe -->
  <iframe 
    src='https://my.spline.design/particles-GyNz08Gkdf1tLRz7jXs3APWz/' 
    frameborder='0' 
    style="width: 100vw; height: 100vh;" 
    class="absolute inset-0 z-0"
  ></iframe>

  <!-- We need an overlay so the button remains clickable without Spline intercepting everything -->
  <div class="absolute inset-0 bg-black/40 z-10 pointer-events-none"></div>

  <div class="relative text-center opacity-0 translate-y-6 z-20 pointer-events-none" id="landingContent">

    <h1 class="text-6xl font-light mb-10">
        Isuru K. Premasiri
    </h1>
    <p class="text-xs tracking-[0.4em] text-gray-500 uppercase mb-8">
        Portfolio — 2026
    </p>

    <button
        id="enterBtn"
        class="enterBtn pointer-events-auto"
    >
        Click to Enter
        <span class="enter-line"></span>
    </button>
  </div>

</section>

