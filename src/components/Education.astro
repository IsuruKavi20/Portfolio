---
import SectionHeader from './SectionHeader.astro';
---

<section id="education" class="relative bg-black text-white py-40 overflow-hidden">

  <div class="max-w-7xl mx-auto px-6 md:px-16">

    <!-- Header — same pattern as Skills & Projects -->
    <div class="mb-20">

      <SectionHeader
        prefix="edu"
        label="Academic Background"
        title="Education"
        description="From school in Kegalle to the University of Moratuwa, plus the courses I take on my own: the foundation behind how I plan, build and deploy."
      />

    </div>

    <!-- Education cards (newest first); the list reveals as one block -->
    <div id="edu-card" class="edu-list" data-reveal>

      <article class="edu-card">
        <div class="edu-bar"></div>
        <div class="edu-card-inner">
          <div class="edu-left">
            <p class="edu-year">2023 - 2028 (expected)</p>
            <h3 class="edu-institution">University of Moratuwa</h3>
            <p class="edu-degree">BSc (Hons) in Information Technology · Faculty of IT · CGPA 3.65</p>
            <div class="edu-divider"></div>
          </div>
          <div class="edu-right">
            <p class="edu-body">
              Studying software engineering, databases, networking and system design. In team projects
              I usually take on the architecture and deployment, and help the team turn a big idea
              into a clear plan.
            </p>
            <div class="edu-tags">
              <span class="edu-tag">Software Engineering</span>
              <span class="edu-tag">System Architecture</span>
              <span class="edu-tag">Networking</span>
              <span class="edu-tag">Cloud Deployment</span>
              <span class="edu-tag">Team Projects</span>
            </div>
          </div>
        </div>
      </article>

      <article class="edu-card">
        <div class="edu-bar"></div>
        <div class="edu-card-inner">
          <div class="edu-left">
            <p class="edu-year">2026</p>
            <h3 class="edu-institution">Certifications</h3>
            <p class="edu-degree">Courses I took to keep learning · tap one to verify</p>
            <div class="edu-divider"></div>
          </div>
          <div class="edu-right">
            <ul class="edu-certs">
              <li><a class="edu-cert-name" href="https://www.coursera.org/account/accomplishments/verify/3W1QQ267XVTS" target="_blank" rel="noopener noreferrer">AWS Cloud Technical Essentials<span class="edu-cert-verify" aria-hidden="true"> ↗</span><span class="sr-only"> (verify certificate, opens in a new tab)</span></a><span class="edu-cert-by">Amazon Web Services</span></li>
              <li><a class="edu-cert-name" href="https://www.coursera.org/account/accomplishments/verify/JDRJ08F9GI7B" target="_blank" rel="noopener noreferrer">Docker for Beginners with Hands-on Labs<span class="edu-cert-verify" aria-hidden="true"> ↗</span><span class="sr-only"> (verify certificate, opens in a new tab)</span></a><span class="edu-cert-by">KodeKloud</span></li>
              <li><a class="edu-cert-name" href="https://www.coursera.org/account/accomplishments/verify/M67T7FLDIYFQ" target="_blank" rel="noopener noreferrer">Jenkins for Beginners<span class="edu-cert-verify" aria-hidden="true"> ↗</span><span class="sr-only"> (verify certificate, opens in a new tab)</span></a><span class="edu-cert-by">KodeKloud</span></li>
              <li><a class="edu-cert-name" href="https://www.coursera.org/account/accomplishments/verify/HNZ5AC2057EL" target="_blank" rel="noopener noreferrer">Git Basics for DevOps<span class="edu-cert-verify" aria-hidden="true"> ↗</span><span class="sr-only"> (verify certificate, opens in a new tab)</span></a><span class="edu-cert-by">KodeKloud</span></li>
              <li><a class="edu-cert-name" href="https://www.credly.com/badges/64ce4a42-3565-48ee-bb37-722a2afa18a5" target="_blank" rel="noopener noreferrer">Networking Basics<span class="edu-cert-verify" aria-hidden="true"> ↗</span><span class="sr-only"> (verify certificate, opens in a new tab)</span></a><span class="edu-cert-by">Cisco Networking Academy</span></li>
              <li><a class="edu-cert-name" href="https://www.credly.com/badges/339eeaab-70c3-4655-b964-0233fce55049" target="_blank" rel="noopener noreferrer">Introduction to Cybersecurity<span class="edu-cert-verify" aria-hidden="true"> ↗</span><span class="sr-only"> (verify certificate, opens in a new tab)</span></a><span class="edu-cert-by">Cisco Networking Academy</span></li>
            </ul>
          </div>
        </div>
      </article>

      <article class="edu-card">
        <div class="edu-bar"></div>
        <div class="edu-card-inner">
          <div class="edu-left">
            <p class="edu-year">2013 - 2020</p>
            <h3 class="edu-institution">St. Mary's College, Kegalle</h3>
            <p class="edu-degree">G.C.E. Advanced Level &amp; Ordinary Level</p>
            <div class="edu-divider"></div>
          </div>
          <div class="edu-right">
            <p class="edu-body">
              Completed my school education here, sitting both the G.C.E. Ordinary Level and
              Advanced Level examinations. This is where my interest in computers and technology began.
            </p>
            <div class="edu-tags">
              <span class="edu-tag">G.C.E. A/L</span>
              <span class="edu-tag">G.C.E. O/L</span>
            </div>
          </div>
        </div>
      </article>

    </div>

  </div>

  <!-- Scroll-out darkening overlay -->
  <div id="education-overlay" class="edu-overlay"></div>

</section>

<style>

/* ── Header ── */





/* ── Card ── */
.edu-card {
  position: relative;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 48px;
  overflow: hidden;
  transition: background 0.4s ease, border-color 0.4s ease, transform 0.4s ease;
}

/* Both cards slide in together (sections.js reveals #edu-card) */
.edu-list {
  display: flex;
  flex-direction: column;
  gap: 24px;
  transform: translateY(30px);
}

.edu-card:hover {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.16);
  transform: translateY(-4px) !important;
}

/* Glowing top bar — same as project/skill cards */
.edu-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s ease;
}
.edu-card:hover .edu-bar {
  transform: scaleX(1);
}

.edu-card-inner {
  display: flex;
  flex-direction: column;
  gap: 40px;
}

@media (min-width: 768px) {
  .edu-card-inner {
    flex-direction: row;
    align-items: flex-start;
    gap: 80px;
  }
}

/* Left */
/* Fixed width on desktop so long degree names wrap instead of crossing the divider */
.edu-left {
  flex-shrink: 0;
  width: 260px;
}

.edu-year {
  font-size: 10px;
  letter-spacing: 0.3em;
  color: rgba(255, 255, 255, 0.45);
  font-family: 'Inter', sans-serif;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.edu-institution {
  font-size: 1.6rem;
  font-weight: 300;
  color: white;
  font-family: 'Inter', sans-serif;
  letter-spacing: -0.01em;
  line-height: 1.2;
  margin-bottom: 10px;
}

.edu-degree {
  font-size: 10px;
  line-height: 1.8;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.4);
  font-family: 'Inter', sans-serif;
}

/* Animated vertical divider — desktop only */
.edu-divider {
  display: none;
}
@media (min-width: 768px) {
  .edu-divider {
    display: block;
    position: absolute;
    left: calc(48px + 260px + 40px); /* card padding + left column + half the gap */
    top: 48px;
    bottom: 48px;
    width: 1px;
    background: rgba(255, 255, 255, 0.07);
  }
}

/* Right */
.edu-right {
  flex: 1;
}

.edu-body {
  font-size: 13px;
  line-height: 1.9;
  color: rgba(255, 255, 255, 0.6);
  font-family: 'Inter', sans-serif;
  margin-bottom: 28px;
}

/* Certification list: name on the left, who issued it on the right */
.edu-certs {
  display: flex;
  flex-direction: column;
}

.edu-certs li {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 4px 16px;
  padding: 12px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.edu-certs li:first-child {
  padding-top: 0;
}

.edu-certs li:last-child {
  border-bottom: 0;
}

.edu-cert-name {
  color: rgba(255, 255, 255, 0.8);
  font-size: 14px;
}

a.edu-cert-name {
  transition: color 0.2s ease;
}

a.edu-cert-name:hover,
a.edu-cert-name:focus-visible {
  color: #fff;
}

.edu-cert-verify {
  color: rgba(255, 255, 255, 0.35);
  font-size: 12px;
}

.edu-cert-by {
  color: rgba(255, 255, 255, 0.4);
  font-size: 11px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.edu-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.edu-tag {
  font-size: 10px;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 4px 12px;
  border-radius: 2px;
  font-family: 'Inter', sans-serif;
  transition: color 0.3s ease, border-color 0.3s ease;
}

.edu-card:hover .edu-tag {
  color: rgba(255, 255, 255, 0.55);
  border-color: rgba(255, 255, 255, 0.15);
}

/* ── Phones ── */
@media (max-width: 767px) {
  #education {
    padding-block: 6rem;
  }

  .edu-card {
    padding: 1.75rem 1.5rem;
  }

  .edu-card:hover {
    transform: none !important;
  }

  .edu-left {
    width: auto;
  }
}

/* ── Scroll-out overlay ── */
.edu-overlay {
  position: absolute;
  inset: 0;
  background: black;
  opacity: 0;
  pointer-events: none;
  z-index: 30;
}

</style>