---
const { number, title, description, tech, status, github, live } = Astro.props;

// Status colour mapping
const statusColor: Record<string, string> = {
  "In Progress":  "status-progress",
  "Coming Soon":  "status-soon",
  "Concept":      "status-concept",
  "Live":         "status-live",
};
const colorClass = statusColor[status] ?? "status-concept";
---

<article class="project-card">

  <!-- Glowing top accent bar (appears on hover) -->
  <div class="card-bar"></div>

  <div>

    <div class="flex items-start justify-between">
      <span class="text-xs tracking-[0.3em] text-gray-600">
        {number}
      </span>

      <span class="card-tag">
        {status}
      </span>
  </div>

    <h3 class="mt-10 text-2xl font-light text-white">
      {title}
    </h3>

    <p class="mt-6 text-sm  text-gray-400 leading-7">
      {description}
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
    {tech.map((item) => (
      <span class="card-tag">{item}</span>      
    ))}
  </div>

  </div>

  <div class="mt-10 flex justify-between border-t border-white/10 pt-6">

    <a href={github} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-widest text-gray-500 hover:text-white">
      GitHub
    </a>

    <a href={live} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-widest text-gray-500 hover:text-white">
      Live
    </a>

  </div>

</article>

<style>

.project-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 360px;
  padding: 32px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: background 0.4s ease, border-color 0.4s ease, transform 0.4s ease;
  overflow: hidden;
}

.project-card:hover {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.18);
  transform: translateY(-4px);
}

/* Glowing top accent bar */
.card-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s ease;
}
.project-card:hover .card-bar {
  transform: scaleX(1);
}

/* Header */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
}

.card-number {
  font-size: 11px;
  letter-spacing: 0.3em;
  color: rgba(255, 255, 255, 0.2);
  font-family: 'Inter', sans-serif;
}

/* Status badges */
.card-status {
  font-size: 9px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 4px 12px;
  border-radius: 999px;
  border: 1px solid;
  font-family: 'Inter', sans-serif;
}

/* Title */
.card-title {
  font-size: clamp(1.25rem, 2vw, 1.6rem);
  font-weight: 300;
  color: white;
  line-height: 1.3;
  letter-spacing: -0.01em;
  font-family: 'Cormorant Garamond', serif;
  margin-bottom: 20px;
}

/* Hairline divider */
.card-divider {
  width: 32px;
  height: 1px;
  background: rgba(255, 255, 255, 0.15);
  margin-bottom: 16px;
  transition: width 0.4s ease;
}
.project-card:hover .card-divider {
  width: 56px;
}

/* Description */

/* Tech tags */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 20px;
}
.card-tag {
  font-size: 10px;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 4px 12px;
  border-radius: 2px;
  font-family: 'Inter', sans-serif;
  transition: color 0.3s ease, border-color 0.3s ease;
}
.project-card:hover .card-tag {
  color: rgba(255, 255, 255, 0.55);
  border-color: rgba(255, 255, 255, 0.15);
}

/* Links */
.card-links {
  display: flex;
  gap: 24px;
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
}
.card-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.35);
  font-family: 'Inter', sans-serif;
  transition: color 0.3s ease, gap 0.3s ease;
}
.card-link:hover {
  color: rgba(255, 255, 255, 0.9);
  gap: 10px;
}

</style>