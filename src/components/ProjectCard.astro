---
const { number, title, description, tech, status, github, live } = Astro.props;
---

<article class="project-card">

  <!-- Glowing top accent bar (appears on hover) -->
  <div class="card-bar"></div>

  <div>

    <div class="flex items-start justify-between">
      <span class="text-xs tracking-[0.3em] text-gray-500">
        {number}
      </span>

      <span class="card-tag">
        {status}
      </span>
  </div>

    <h3 class="mt-10 text-2xl font-light text-white">
      {title}
    </h3>

    <p class="mt-6 text-sm  text-gray-400 leading-7">
      {description}
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
    {tech.map((item) => (
      <span class="card-tag">{item}</span>      
    ))}
  </div>

  </div>

  <div class="mt-10 flex justify-between border-t border-white/10 pt-6">

    <a href={github} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-widest text-gray-500 hover:text-white">
      GitHub
    </a>

    <a href={live} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-widest text-gray-500 hover:text-white">
      Live
    </a>

  </div>

</article>

<style>

.project-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 360px;
  padding: 32px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: background 0.4s ease, border-color 0.4s ease, transform 0.4s ease;
  overflow: hidden;
}

.project-card:hover {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.18);
  transform: translateY(-4px);
}

/* Glowing top accent bar */
.card-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s ease;
}
.project-card:hover .card-bar {
  transform: scaleX(1);
}







.card-tag {
  font-size: 10px;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 4px 12px;
  border-radius: 2px;
  font-family: 'Inter', sans-serif;
  transition: color 0.3s ease, border-color 0.3s ease;
}
.project-card:hover .card-tag {
  color: rgba(255, 255, 255, 0.55);
  border-color: rgba(255, 255, 255, 0.15);
}


</style>