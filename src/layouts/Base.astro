---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import AskIsuru from '../components/bot/AskIsuru.astro';
import headInit from './head-init.js?raw';
import { NOSCRIPT_CSS } from './inline-css.mjs';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Isuru K. Premasiri | Portfolio',
  description = 'Isuru K. Premasiri, an IT student at the University of Moratuwa who learns by building: clean screens, solid systems and secure cloud apps.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <!-- Other sites only learn which site a visitor came from, never the exact page -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <!-- Link previews (LinkedIn, WhatsApp, X, Slack): title, text and image -->
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Isuru K. Premasiri" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Isuru K. Premasiri: I plan how a system fits together, then take it to the cloud and keep it running." />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Runs before first paint: animation allowed? already entered? quality tier?
         Its exact text is fingerprinted in astro.config.mjs for the security policy. -->
    <script is:inline set:html={headInit} />
    <noscript><style is:inline set:html={NOSCRIPT_CSS} /></noscript>
  </head>
  <body>
    <a class="skip-link sr-only-focusable" href="#main">Skip to content</a>
    <Cursor />
    <slot name="chrome" />
    <main id="main">
      <slot />
    </main>
    <AskIsuru />
  </body>
</html>
