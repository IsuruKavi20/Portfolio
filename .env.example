# Copy to .env for local development. Never commit .env.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Google AI Studio key. Without it, Ask Isuru answers in demo mode.
# Create it in a project with NO billing attached, so abuse can never cost money.
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Kill switch: set to false to turn the bot off instantly
CHAT_ENABLED=true

# Resend key for the contact form ("Sending access" only). Starts with re_
RESEND_API_KEY=
